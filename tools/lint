#!/bin/bash -eu

rc=0
out=$(go fmt ./...) || rc=$?
if [ -n "$out" ]; then
	echo "go fmt reformatted:"
	printf '%s\n' "$out"
	echo
fi
nolint=$(grep -rn '//[[:space:]]*nolint' --include='*.go' .) || [ "$?" -eq 1 ] || rc=1
if [ -n "$nolint" ]; then
	echo "nolint directives are banned. Fix the underlying finding instead:"
	printf '%s\n' "$nolint"
	echo
	rc=1
fi
go tool golangci-lint run ./... || rc=$?
go mod tidy || rc=$?
go build -o /tmp/exportedmutex ./tools/analyzers/cmd/exportedmutex && \
  go vet -vettool=/tmp/exportedmutex ./... || rc=$?

exit $rc
