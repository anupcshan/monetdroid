#!/bin/bash -eu

rc=0
out=$(go fmt ./...) || rc=$?
if [ -n "$out" ]; then
	echo "go fmt reformatted:"
	printf '%s\n' "$out"
	echo
fi
go tool golangci-lint run ./... || rc=$?
go build -o /tmp/exportedmutex ./tools/analyzers/cmd/exportedmutex && \
  go vet -vettool=/tmp/exportedmutex ./... || rc=$?

exit $rc
